{
    "compilerOptions": {
        "outDir": "dist",
        "module": "commonjs",
        "target": "ES2020",
        "lib": ["ES2020"],
        "rootDir": "fontes",
        "sourceMap": true,
        "declaration": true,
        "declarationMap": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "moduleResolution": "node",
        "ignoreDeprecations": "5.0",
        "types": ["jest", "node"],
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true
    },
    "exclude": ["dist", "node_modules", "testes"]
}
